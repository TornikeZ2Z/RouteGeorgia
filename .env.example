# ---- Database -------------------------------------------------------------
# Local embedded Postgres (created by `npm run db:start`). No Docker required.
DATABASE_URL="postgres://app:app@127.0.0.1:55432/gotrip"

# Database the test suite is allowed to WRITE to. tests/db.test.ts inserts
# availability blocks and an audit row that cannot be deleted afterwards, so it
# never uses DATABASE_URL. Leave this unset and those tests skip cleanly.
# TEST_DATABASE_URL="postgres://app:app@127.0.0.1:55432/gotrip_test"

# ---- Application ----------------------------------------------------------
APP_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-64-char-hex-string-generated-with-the-command-above"

# ---- Marketplace policy (see DECISIONS.md) --------------------------------
COMMISSION_RATE_BPS="1500"          # 15.00% in basis points
CANONICAL_CURRENCY="GEL"
PRICE_ROUNDING_STEP_MINOR="50"      # round quotes to nearest 0.50 GEL
QUOTE_TTL_SECONDS="900"             # 15 minutes
HOLD_TTL_SECONDS="600"              # 10 minutes
DRIVER_ACK_SLA_MINUTES="10"

# ---- Adapters -------------------------------------------------------------
# "haversine" needs no API key and is fine for Phase 0/1. Swap to a real
# directions provider before taking public bookings.
ROUTING_PROVIDER="haversine"
ROUTING_API_KEY=""
# "local" writes to ./.storage. Swap to s3 for production.
STORAGE_DRIVER="local"

# ---- Contracting entity ---------------------------------------------------
# Printed into the driver agreement. The agreement cannot be published for
# signature until all three are set — see src/lib/contract.ts.
COMPANY_LEGAL_NAME=""
COMPANY_ID_NUMBER=""
COMPANY_ADDRESS=""
