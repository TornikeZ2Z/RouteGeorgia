# Production environment variables.
# On Vercel these go in Project → Settings → Environment Variables.
# Do NOT commit the filled-in version.

# Your Neon connection string. Use the POOLED one for the app.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# The public address. Canonical tags, hreflang, email links and payment return
# URLs are all built from this, so it must be the domain travellers see.
APP_URL="https://routegeorgia.ge"

# Turn on ONLY after the custom domain resolves and serves. It redirects the
# hosting subdomain to the custom domain; enabled too early it points every
# visitor at a hostname that does not exist yet.
ENFORCE_CANONICAL_HOST="false"

# Generate a NEW one for production. Never reuse the development secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

COMMISSION_RATE_BPS="1500"
CANONICAL_CURRENCY="GEL"
PRICE_ROUNDING_STEP_MINOR="50"
QUOTE_TTL_SECONDS="900"
HOLD_TTL_SECONDS="600"
DRIVER_ACK_SLA_MINUTES="10"

# Replace before quoting real customers — the estimator is not road routing.
ROUTING_PROVIDER="haversine"
ROUTING_API_KEY=""

# Local disk does not persist on Vercel. Uploaded photos and documents need
# S3 or Cloudflare R2 before drivers upload anything you cannot afford to lose.
STORAGE_DRIVER="local"

# Public contact details. The phone appears in the header and footer the
# moment it is set — leave empty until the business SIM exists.
SUPPORT_PHONE=""
SUPPORT_EMAIL="support@routegeorgia.ge"
